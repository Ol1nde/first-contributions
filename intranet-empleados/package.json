{
  "name": "intranet-empleados",
  "version": "1.0.0",
  "description": "Intranet para la gestión de empleados: directorio, departamentos, ausencias y vacaciones, registro de jornada y anuncios.",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "demo": "node --disable-warning=ExperimentalWarning src/server.js --demo",
    "restablecer-clave": "node --disable-warning=ExperimentalWarning src/server.js --restablecer-clave",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6"
  },
  "license": "MIT"
}
